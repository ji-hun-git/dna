{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genome-companion.kr/schemas/signed-workload-jwks-release.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "signatureBase64Url", "releaseKeyId"],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "sequence", "generatedAt", "keys", "documentDigest"],
      "properties": {
        "schemaVersion": {"const": "workload-jwks.v1"},
        "sequence": {"type": "integer", "minimum": 1},
        "generatedAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "keys": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kty", "crv", "alg", "use", "kid", "x", "role", "notBefore", "notAfter"],
            "properties": {
              "kty": {"const": "OKP"}, "crv": {"const": "Ed25519"}, "alg": {"const": "EdDSA"}, "use": {"const": "sig"},
              "kid": {"type": "string", "pattern": "^workload-[A-Za-z0-9_-]{1,64}$"},
              "x": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
              "role": {"enum": ["previous", "current", "next"]},
              "notBefore": {"type": "string", "format": "date-time", "pattern": "Z$"},
              "notAfter": {"type": "string", "format": "date-time", "pattern": "Z$"}
            }
          }
        },
        "documentDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "signatureBase64Url": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"},
    "releaseKeyId": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}

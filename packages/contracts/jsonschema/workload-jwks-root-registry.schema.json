{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genome-companion.kr/schemas/workload-jwks-root-registry.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "sequence", "generatedAt", "roots", "registryDigest"],
  "properties": {
    "schemaVersion": {"const": "workload-jwks-root-registry.v1"},
    "sequence": {"type": "integer", "minimum": 1},
    "generatedAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "roots": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["releaseKeyId", "publicKeyRawBase64Url", "publicKeySha256", "notBefore", "notAfter", "state"],
        "properties": {
          "releaseKeyId": {"type": "string", "minLength": 1, "maxLength": 128},
          "publicKeyRawBase64Url": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
          "publicKeySha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "notBefore": {"type": "string", "format": "date-time", "pattern": "Z$"},
          "notAfter": {"type": "string", "format": "date-time", "pattern": "Z$"},
          "state": {"enum": ["next", "active", "retired", "revoked"]}
        }
      }
    },
    "registryDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}

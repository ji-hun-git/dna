{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genome-companion.kr/schemas/workload-jwks-keygen-request.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "operation", "expectedActiveFence", "notBefore", "notAfter", "sourceSha", "requestedAt", "expiresAt", "requestSha256"],
  "properties": {
    "schemaVersion": {"const": "workload-jwks-keygen-request.v1"},
    "requestId": {"type": "string", "format": "uuid"},
    "operation": {"enum": ["initial", "rotate"]},
    "expectedActiveFence": {"type": ["integer", "null"], "minimum": 0},
    "notBefore": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "notAfter": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "sourceSha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requestedAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "expiresAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "requestSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genome-companion.kr/schemas/signed-workload-jwks-root-registry.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["registry", "signatureBase64Url", "registrySigningKeyId"],
  "properties": {
    "registry": {"$ref": "workload-jwks-root-registry.schema.json"},
    "signatureBase64Url": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"},
    "registrySigningKeyId": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}

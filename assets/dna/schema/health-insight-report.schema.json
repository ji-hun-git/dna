{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dna.health.v1.healthInsightReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["subjectId", "generatedAt", "insights", "knownMarkers", "missingMarkers", "nextActions"],
  "properties": {
    "subjectId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "summary": { "type": "string" },
    "knownMarkers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "missingMarkers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "insights": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "priority", "confidence", "reasoning", "action"],
        "properties": {
          "title": { "type": "string" },
          "priority": { "type": "string", "enum": ["high", "medium", "low"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reasoning": { "type": "string" },
          "action": { "type": "string" },
          "relatedMarkers": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "nextActions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
